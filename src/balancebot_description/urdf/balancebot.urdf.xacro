<?xml version="1.0"?>
<robot name="balancebot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include Materials and Sensors -->
  <xacro:include filename="materials.xacro" />
  <xacro:include filename="sensors.xacro" />

  <!-- Geometric & Physical Properties -->
  <xacro:property name="torso_mass" value="12.0" />
  <xacro:property name="torso_len" value="0.35" />
  <xacro:property name="torso_width" value="0.25" />
  <xacro:property name="torso_height" value="0.20" />

  <xacro:property name="thigh_mass" value="0.8" />
  <xacro:property name="thigh_length" value="0.20" />
  <xacro:property name="thigh_radius" value="0.025" />

  <xacro:property name="shin_mass" value="0.8" />
  <xacro:property name="shin_length" value="0.20" />
  <xacro:property name="shin_radius" value="0.022" />

  <xacro:property name="wheel_mass" value="1.5" />
  <xacro:property name="wheel_radius" value="0.10" />
  <xacro:property name="wheel_width" value="0.05" />

  <xacro:property name="hip_offset_y" value="0.15" />
  <xacro:property name="hip_offset_z" value="-0.05" />
  <xacro:property name="wheel_spacing_y" value="0.04" />

  <!-- Base footprint (Ground projection) -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.45" rpy="0 0 0"/>
  </joint>

  <!-- ================= Torso / Base Link ================= -->
  <link name="base_link">
    <inertial>
      <mass value="${torso_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- Ixx = 1/12 * m * (w^2 + h^2) = 0.1025 -->
      <!-- Iyy = 1/12 * m * (l^2 + h^2) = 0.1625 -->
      <!-- Izz = 1/12 * m * (l^2 + w^2) = 0.1850 -->
      <inertia ixx="0.1025" ixy="0" ixz="0"
               iyy="0.1625" iyz="0"
               izz="0.1850"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${torso_len} ${torso_width} ${torso_height}"/>
      </geometry>
      <material name="chassis_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${torso_len} ${torso_width} ${torso_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- ================= Leg Macro ================= -->
  <xacro:macro name="leg" params="prefix reflect">
    <!-- Hip Joint (Pitch revolute around Y) -->
    <joint name="${prefix}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_thigh_link"/>
      <origin xyz="0.0 ${reflect * hip_offset_y} ${hip_offset_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.20" upper="1.20" effort="50.0" velocity="10.0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- Thigh Link -->
    <link name="${prefix}_thigh_link">
      <inertial>
        <mass value="${thigh_mass}"/>
        <origin xyz="0 0 ${-thigh_length / 2}" rpy="0 0 0"/>
        <inertia ixx="0.0028" ixy="0" ixz="0"
                 iyy="0.0028" iyz="0"
                 izz="0.00025"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${-thigh_length / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${thigh_radius}" length="${thigh_length}"/>
        </geometry>
        <material name="leg_metal"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-thigh_length / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${thigh_radius}" length="${thigh_length}"/>
        </geometry>
      </collision>
    </link>

    <!-- Knee Joint (Pitch revolute around Y) -->
    <joint name="${prefix}_knee_joint" type="revolute">
      <parent link="${prefix}_thigh_link"/>
      <child link="${prefix}_shin_link"/>
      <origin xyz="0 0 ${-thigh_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- Supports range 0 deg (straight) to 130 deg (crouched), covering height [0.18, 0.38] m -->
      <limit lower="0.0" upper="2.30" effort="50.0" velocity="10.0"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- Shin Link -->
    <link name="${prefix}_shin_link">
      <inertial>
        <mass value="${shin_mass}"/>
        <origin xyz="0 0 ${-shin_length / 2}" rpy="0 0 0"/>
        <inertia ixx="0.0028" ixy="0" ixz="0"
                 iyy="0.0028" iyz="0"
                 izz="0.00025"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${-shin_length / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${shin_radius}" length="${shin_length}"/>
        </geometry>
        <material name="leg_metal"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${-shin_length / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${shin_radius}" length="${shin_length}"/>
        </geometry>
      </collision>
    </link>

    <!-- Wheel Joint (Pitch continuous around Y) -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_shin_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0.0 ${reflect * wheel_spacing_y} ${-shin_length}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="25.0" velocity="30.0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <!-- Wheel Link -->
    <link name="${prefix}_wheel_link">
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <!-- Cylinder with radius 0.10, length 0.05, mass 1.5 -->
        <!-- Iyy (symmetry axis Y) = 1/2 * m * r^2 = 0.0075 -->
        <!-- Ixx = Izz = 1/12 * m * (3*r^2 + h^2) = 0.00406 -->
        <inertia ixx="0.00406" ixy="0" ixz="0"
                 iyy="0.00750" iyz="0"
                 izz="0.00406"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_rubber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <!-- Gazebo Surface Friction for Wheel -->
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>0.9</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- Joint Transmissions -->
    <transmission name="${prefix}_hip_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}_hip_joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}_hip_motor">
        <mechanicalReduction>1.0</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="${prefix}_knee_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}_knee_joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}_knee_motor">
        <mechanicalReduction>1.0</mechanicalReduction>
      </actuator>
    </transmission>

    <transmission name="${prefix}_wheel_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${prefix}_wheel_joint">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${prefix}_wheel_motor">
        <mechanicalReduction>1.0</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <!-- Instantiate Left and Right Legs -->
  <xacro:leg prefix="left" reflect="1" />
  <xacro:leg prefix="right" reflect="-1" />

  <!-- ================= Gazebo Plugins ================= -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>left_wheel_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>left_hip_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>left_knee_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>right_hip_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>right_knee_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
