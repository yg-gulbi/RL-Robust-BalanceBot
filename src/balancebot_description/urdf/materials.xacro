<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <material name="chassis_dark">
    <color rgba="0.22 0.22 0.25 1.0"/>
  </material>

  <material name="leg_metal">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>

  <material name="wheel_rubber">
    <color rgba="0.12 0.12 0.12 1.0"/>
  </material>

  <material name="wheel_rim">
    <color rgba="0.95 0.45 0.10 1.0"/>
  </material>

  <material name="sensor_blue">
    <color rgba="0.10 0.45 0.85 1.0"/>
  </material>

  <material name="sensor_lens">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
</robot>
